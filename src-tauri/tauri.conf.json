{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transmutio",
  "version": "1.0.0-alpha7",
  "identifier": "app.transmutio.desktop",
  "mainBinaryName": "Transmutio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Transmutio",
        "width": 1400,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ffmpeg/*",
      "resources/licenses/README.txt",
      "resources/licenses/LGPL-2.1.txt",
      "resources/licenses/LGPL-3.0.txt",
      "resources/licenses/THIRD-PARTY-NOTICES-LGPL.txt",
      "resources/licenses/SOURCE-ACQUISITION-LGPL.txt"
    ],
    "shortDescription": "跨平台多媒体转换",
    "longDescription": "Transmutio：视频/音频/图片批量转换，硬件编码优先，失败自动回退。",
    "copyright": "Transmutio",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "{5C1F7A2E-8D34-5B96-A1E7-C4D2F908B365}",
        "fragmentPaths": [
          "wix/legacy-block.wxs"
        ],
        "componentGroupRefs": [
          "TransmutioLegacyGuard"
        ],
        "version": "1.0.0.7"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements/app.entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
